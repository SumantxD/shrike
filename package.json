{
  "name": "shrike",
  "private": true,
  "license": "MIT",
  "author": "Sumant Tirkey <st72365@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/SumantxD/shrike.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @shrike/browser-agent build && pnpm --filter @shrike/desktop dev",
    "build": "pnpm --filter @shrike/browser-agent build && pnpm --filter @shrike/desktop build",
    "test": "node --test --experimental-test-isolation=none 'packages/*/test/*.test.ts' 'packages/*/test/*.test.mjs' 'apps/desktop/src/**/*.test.ts' 'integrations/*/test/*.test.mjs' 'fixtures/*/test/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @shrike/desktop typecheck",
    "e2e": "pnpm build && pnpm --filter @shrike/desktop e2e"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.19.2"
  }
}
